# Server running port for the User Service
PORT=8081

# PostgreSQL database connection string
DATABASE_URL=postgresql://gratia:gratia123@localhost:5432/gratia?sslmode=disable

# Secret key required to validate JWTs issued by the Auth Service
JWT_SECRET=your_super_secure_jwt_secret

# Current deployment environment like development or production
ENV=development

# Verbosity of structured logs like info or debug
LOG_LEVEL=info