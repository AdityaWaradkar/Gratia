{
  "info": {
    "name": "Gratia Auth Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "url": {"raw": "http://localhost:8080/auth/register","protocol":"http","host":["localhost"],"port":"8080","path":["auth","register"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"DONOR\"\n}"
        }
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "url": {"raw": "http://localhost:8080/auth/login","protocol":"http","host":["localhost"],"port":"8080","path":["auth","login"]},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "url": {"raw": "http://localhost:8080/auth/refresh","protocol":"http","host":["localhost"],"port":"8080","path":["auth","refresh"]},
        "body": {"mode":"raw","raw":"{\n  \"refreshToken\": \"<refresh_token_here>\"\n}"}
      }
    },
    {
      "name": "Logout User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "url": {"raw": "http://localhost:8080/auth/logout","protocol":"http","host":["localhost"],"port":"8080","path":["auth","logout"]},
        "body": {"mode":"raw","raw":"{\n  \"refreshToken\": \"<refresh_token_here>\"\n}"}
      }
    }
  ]
}
