# Server running port
PORT=8080

# PostgreSQL database connection string
DATABASE_URL=postgresql://gratia:gratia123@localhost:5432/gratia?sslmode=disable

# Secret key for signing JWT tokens
JWT_SECRET=your_super_secure_jwt_secret

# Access token lifespan in minutes
ACCESS_TOKEN_MINUTES=15

# Refresh token lifespan in days
REFRESH_TOKEN_DAYS=30

# Current deployment environment like development or production
ENV=development

# Verbosity of structured logs like info or debug
LOG_LEVEL=info